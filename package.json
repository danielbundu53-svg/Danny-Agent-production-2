{
  "name": "danny-agent-website",
  "version": "1.0.0",
  "private": true,
  "description": "Danny Agent real estate website: pages, API and database",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "build": "node scripts/build.js",
    "backup": "node scripts/backup-db.js",
    "restore": "node scripts/restore-db.js",
    "test": "node --test tests/server.test.js tests/chat.test.js tests/api-extended.test.js tests/api-security.test.js",
    "test:browser": "node tests/browser.test.mjs",
    "test:chat": "node tests/chat-browser.test.mjs",
    "test:responsive": "node tests/responsive.test.mjs",
    "test:slow": "node tests/slow-network.test.mjs",
    "icons": "node scripts/make-icons.js",
    "test:all": "npm test && npm run test:browser && npm run test:chat && npm run test:responsive"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "compression": "^1.8.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "sharp": "^0.35.5",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "lucide": "^1.52.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^3.4.19"
  }
}
