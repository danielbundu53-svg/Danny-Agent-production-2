# Copy this file to ".env" (same folder as package.json) and fill it in.
# Never share the .env file or put it in a public place.

# Use "production" on the live server. Turns on https-only headers and strict checks.
NODE_ENV=production

# The port the server listens on. Most hosts set this for you.
PORT=5000

# Password for the admin page. At least 24 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_KEY=put-a-long-random-key-here

# Your public address, no slash at the end. Used for link previews, sitemap and robots.txt.
SITE_URL=https://www.example.com

# Hosts put a proxy in front of the server. 1 is right for Render, Railway, Fly, Heroku.
# TRUST_PROXY=1

# Redirect http to https. Turn on only after https works on your address.
# FORCE_HTTPS=true

# Where the database and resized photos live. On a host, point these at a persistent disk.
# DATABASE_PATH=/var/data/danny-angel.sqlite
# CACHE_DIR=/var/data/cache

# debug, info, warn or error
# LOG_LEVEL=info

# ---- Chat assistant (optional). Without a key the chat window simply does not appear. ----
# Get a key at console.anthropic.com > API keys, and set a monthly spend limit there too.
# ANTHROPIC_API_KEY=sk-ant-...
# Most messages the assistant answers per day on the whole site. Caps your bill. Default 400.
# CHAT_DAILY_LIMIT=400
# Model used for chat. The default is small, fast and cheap.
# CHAT_MODEL=claude-haiku-4-5-20251001
